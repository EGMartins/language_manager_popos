#!/usr/bin/env bash
#
# devlang — instala/remove uma linguagem + suporte no editor (parser do
#           Treesitter, LSP via Mason, formatter), estilo omarchy-install-dev-*.
#
# Uso:
#   devlang                     menu unificado (○ instala · ● remove)
#   devlang go rust python      instala essas linguagens
#   devlang -r go               remove a linguagem (config + parser/LSP órfãos)
#   devlang --remove            menu só com as linguagens instaladas
#   devlang --list              lista os ids e o que está instalado
#   devlang --appname astronvim go   mira outro distro (ver: deveditor --list)
#   devlang --gui               força o menu gráfico (zenity)
#
#   Alvo padrão: ~/.config/nvim. Detecta LazyVim / AstroNvim / NvChad / kickstart.
#   No LazyVim usa os "extras"; nos outros instala parser+LSP direto.
#
set -euo pipefail

# resolve o diretório real do script (mesmo chamado via symlink em ~/.local/bin)
_self="$(readlink -f "${BASH_SOURCE[0]}")"
DEVLANG_HOME="${DEVLANG_HOME:-$(dirname "$_self")}"

DEVTOOL=devlang
# shellcheck source=/dev/null
source "$DEVLANG_HOME/lib.sh"
# shellcheck source=/dev/null
source "$DEVLANG_HOME/registry.sh"

# --------------------------------------------------------------------------
# alvo: qual config de Neovim (LazyVim padrão, ou um distro via --appname)
# --------------------------------------------------------------------------
APPNAME="${NVIM_APPNAME:-nvim}"          # sobrescrito por --appname
NVIM_CONFIG="$HOME/.config/$APPNAME"
LAZYVIM_JSON="$NVIM_CONFIG/lazyvim.json"
DISTRO=""                                # preenchido por set_target()

set_target() {   # $1 = appname
  APPNAME="$1"
  NVIM_CONFIG="$HOME/.config/$APPNAME"
  LAZYVIM_JSON="$NVIM_CONFIG/lazyvim.json"
  STATE_FILE="$STATE_DIR/$APPNAME.installed"
  DISTRO="$(detect_distro "$NVIM_CONFIG")"
}

detect_distro() {   # $1 = dir de config -> lazyvim|astronvim|nvchad|kickstart|unknown
  local d="$1"
  [[ -f "$d/lazyvim.json" ]] && { echo lazyvim; return; }
  [[ -f "$d/lua/community.lua" ]] && { echo astronvim; return; }
  [[ -f "$d/lua/chadrc.lua" ]] && { echo nvchad; return; }
  grep -rqs "kickstart" "$d/init.lua" 2>/dev/null && { echo kickstart; return; }
  [[ -f "$d/init.lua" || -f "$d/init.vim" ]] && { echo unknown; return; }
  echo none
}

# --------------------------------------------------------------------------
# estado: quais linguagens foram instaladas (por appname)
# --------------------------------------------------------------------------
STATE_DIR="${DEVLANG_STATE:-$HOME/.local/state/devlang}"
STATE_FILE="$STATE_DIR/$APPNAME.installed"
# migração do formato antigo (arquivo único "installed" == alvo nvim)
[[ -f "$STATE_DIR/installed" && ! -f "$STATE_DIR/nvim.installed" ]] && \
  mv "$STATE_DIR/installed" "$STATE_DIR/nvim.installed"

state_has()  { sf_has "$STATE_FILE" "$1"; }
state_add()  { sf_add "$STATE_FILE" "$1"; }
state_del()  { sf_del "$STATE_FILE" "$1"; }
state_list() { sf_list "$STATE_FILE"; }

DISTRO="$(detect_distro "$NVIM_CONFIG")"

# instalada = está no state file OU (no LazyVim) o extra correspondente está ativo
is_installed() {
  state_has "$1" && return 0
  [[ "$DISTRO" == lazyvim || -z "$DISTRO" ]] || return 1
  local extra=""
  LABEL=""; LAZY_EXTRA=""; "lang_$1"; extra="$LAZY_EXTRA"
  [[ -n "$extra" ]] && grep -qF "\"$extra\"" "$LAZYVIM_JSON" 2>/dev/null
}

# --------------------------------------------------------------------------
# dependências base: mise (runtimes) + git/curl/build-essential
# --------------------------------------------------------------------------
ensure_base() {
  local want_mise="${1:-}"
  # mise costuma ficar em ~/.local/bin, que pode não estar no PATH de um shell não-interativo
  [[ -x "$HOME/.local/bin/mise" ]] && case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
  local need=()
  have curl || need+=(curl)
  have git  || need+=(git)
  have unzip || need+=(unzip)
  dpkg -s build-essential >/dev/null 2>&1 || need+=(build-essential)
  if ((${#need[@]})); then
    say "Instalando dependências base: ${need[*]}"
    sudo apt-get update -qq
    sudo apt-get install -y "${need[@]}"
  fi

  if [[ -n "${want_mise// }" ]] && ! have mise; then
    say "Instalando mise (gerenciador de runtimes)"
    curl -fsSL https://mise.run | sh
    export PATH="$HOME/.local/bin:$PATH"
    hint_shell_activation
  fi
}

hint_shell_activation() {
  local line
  case "${SHELL##*/}" in
    zsh)  line='eval "$(~/.local/bin/mise activate zsh)"';  rc="$HOME/.zshrc" ;;
    bash) line='eval "$(~/.local/bin/mise activate bash)"'; rc="$HOME/.bashrc" ;;
    fish) line='~/.local/bin/mise activate fish | source';  rc="$HOME/.config/fish/config.fish" ;;
    *) return 0 ;;
  esac
  if [[ -f "$rc" ]] && ! grep -qF 'mise activate' "$rc"; then
    printf '\n# mise (devlang)\n%s\n' "$line" >> "$rc"
    ok "Ativação do mise adicionada em $rc (reabra o terminal depois)"
  fi
}

# --------------------------------------------------------------------------
# apt / mise / lazyvim.json
# --------------------------------------------------------------------------
install_apt() {
  [[ -z "${1// }" ]] && return 0
  local pending=()
  for p in $1; do dpkg -s "$p" >/dev/null 2>&1 || pending+=("$p"); done
  ((${#pending[@]})) || { ok "apt: nada a instalar"; return 0; }
  say "apt: ${pending[*]}"
  sudo apt-get update -qq
  sudo apt-get install -y "${pending[@]}"
}

install_mise() {
  [[ -z "${1// }" ]] && return 0
  have mise || { export PATH="$HOME/.local/bin:$PATH"; }
  for tool in $1; do
    say "mise use -g $tool"
    mise use -g "$tool"
    ok "$tool -> $(mise which "${tool%@*}" 2>/dev/null || echo instalado)"
  done
}

# adiciona um extra ao array "extras" de lazyvim.json sem duplicar
add_lazy_extra() {
  local extra="$1"
  [[ -z "$extra" ]] && return 0
  [[ -f "$LAZYVIM_JSON" ]] || echo '{ "extras": [], "version": 8 }' > "$LAZYVIM_JSON"

  if grep -qF "\"$extra\"" "$LAZYVIM_JSON"; then
    ok "LazyVim extra já ativo: $extra"
    return 0
  fi

  say "Ativando extra do LazyVim: $extra"
  if have jq; then
    tmp=$(mktemp)
    jq --arg e "$extra" '.extras = ((.extras // []) + [$e] | unique)' "$LAZYVIM_JSON" > "$tmp"
    mv "$tmp" "$LAZYVIM_JSON"
  else
    # fallback sem jq: nvim edita o próprio json
    nvim --headless -u NONE -c "
      lua local f='$LAZYVIM_JSON'; local d=vim.json.decode(table.concat(vim.fn.readfile(f),'\n'))
      d.extras = d.extras or {}
      local seen=false; for _,v in ipairs(d.extras) do if v=='$extra' then seen=true end end
      if not seen then table.insert(d.extras, '$extra') end
      vim.fn.writefile(vim.split(vim.json.encode(d),'\n'), f)
    " -c "qa" 2>/dev/null
  fi
  ok "extra adicionado"
}

# remove um extra do array "extras" de lazyvim.json
remove_lazy_extra() {
  local extra="$1"
  [[ -z "$extra" ]] && return 0
  [[ -f "$LAZYVIM_JSON" ]] || return 0
  grep -qF "\"$extra\"" "$LAZYVIM_JSON" || { ok "extra do LazyVim já ausente: $extra"; return 0; }

  say "Removendo extra do LazyVim: $extra"
  if have jq; then
    local tmp; tmp=$(mktemp)
    jq --arg e "$extra" '.extras = ((.extras // []) - [$e])' "$LAZYVIM_JSON" > "$tmp"
    mv "$tmp" "$LAZYVIM_JSON"
  else
    nvim --headless -u NONE -c "
      lua local f='$LAZYVIM_JSON'; local d=vim.json.decode(table.concat(vim.fn.readfile(f),'\n'))
      d.extras = vim.tbl_filter(function(v) return v ~= '$extra' end, d.extras or {})
      vim.fn.writefile(vim.split(vim.json.encode(d),'\n'), f)
    " -c "qa" 2>/dev/null
  fi
  ok "extra removido"
}

# --------------------------------------------------------------------------
# execução do Neovim no alvo (respeita NVIM_APPNAME)
# --------------------------------------------------------------------------
nvim_run() {
  if [[ "$APPNAME" == nvim ]]; then timeout 1200 nvim --headless "$@"
  else timeout 1200 env NVIM_APPNAME="$APPNAME" nvim --headless "$@"; fi
}
_filter_provision() { grep -E '\[provision\]|error|Error|warning' | sed 's/^/    /'; }

# LazyVim: provision.lua completo (extras + parser + LSP + prune)
provision_lazyvim() {
  local mason="$1" ts="$2" prune="${3:-}"
  [[ -f "$NVIM_CONFIG/init.lua" ]] || { warn "sem $NVIM_CONFIG/init.lua"; return 0; }
  if [[ "$prune" == prune ]]; then say "Sincronizando (removendo parsers/LSP não usados)…"
  else say "Sincronizando LazyVim (plugins, parser, LSP via Mason)… pode demorar na 1ª vez"; fi
  DEVLANG_MASON="$mason" DEVLANG_TS="$ts" \
  DEVLANG_PRUNE="$([[ "$prune" == prune ]] && echo 1 || echo 0)" \
    nvim_run -c "luafile $DEVLANG_HOME/provision.lua" 2>&1 | _filter_provision \
    || warn "provisionamento terminou com avisos"
  ok "Neovim sincronizado"
}

# AstroNvim / NvChad / kickstart: instala parser + LSP direto (provision_generic.lua)
provision_generic() {
  local ts="$1" mason="$2" prune_ts="${3:-}" prune_mason="${4:-}"
  [[ -f "$NVIM_CONFIG/init.lua" ]] || { warn "sem $NVIM_CONFIG/init.lua"; return 0; }
  say "Instalando parser (Treesitter) + LSP (Mason) no ~/.config/$APPNAME…"
  DEVLANG_TS="$ts" DEVLANG_MASON="$mason" \
  DEVLANG_PRUNE_TS="$prune_ts" DEVLANG_PRUNE_MASON="$prune_mason" \
    nvim_run -c "luafile $DEVLANG_HOME/provision_generic.lua" 2>&1 | _filter_provision \
    || warn "provisionamento terminou com avisos"
  ok "Neovim sincronizado"
}

# ---- AstroNvim: imports do astrocommunity em lua/community.lua ------------
astro_community() { echo "$NVIM_CONFIG/lua/community.lua"; }
astro_pack_of()   { echo "${ASTRO_MAP[$1]:-$1}"; }

add_astro_pack() {
  local pack="astrocommunity.pack.$(astro_pack_of "$1")" f; f="$(astro_community)"
  [[ -f "$f" ]] || { warn "sem $f (AstroNvim incompleto?)"; return 1; }
  grep -qF "\"$pack\"" "$f" && { ok "astrocommunity já ativo: $pack"; return 0; }
  say "Ativando pack do astrocommunity: $pack"
  if grep -q '"AstroNvim/astrocommunity"' "$f"; then
    sed -i "s#\(\"AstroNvim/astrocommunity\",\)#\1\n  { import = \"$pack\" },#" "$f"
  else
    sed -i "s#^return {#return {\n  { import = \"$pack\" },#" "$f"
  fi
  ok "pack adicionado"
}
remove_astro_pack() {
  local pack="astrocommunity.pack.$(astro_pack_of "$1")" f; f="$(astro_community)"
  [[ -f "$f" ]] || return 0
  grep -qF "\"$pack\"" "$f" || { ok "astrocommunity já ausente: $pack"; return 0; }
  say "Removendo pack do astrocommunity: $pack"
  sed -i "\#import = \"$pack\"#d" "$f"
  ok "pack removido"
}

# parser/LSP desta linguagem que nenhuma outra ainda-instalada usa
compute_prune_sets() {   # $1 = id ; seta PRUNE_TS / PRUNE_MASON
  local rid="$1" keepts=" " keepm=" " other p
  while read -r other; do
    [[ -z "$other" || "$other" == "$rid" ]] && continue
    keepts+=" ${TS_MAP[$other]:-$other} "
    keepm+=" ${LSP_MAP[$other]:-} "
  done < <(state_list)
  PRUNE_TS=""; PRUNE_MASON=""
  for p in ${TS_MAP[$rid]:-$rid}; do [[ "$keepts" == *" $p "* ]] || PRUNE_TS+=" $p"; done
  for p in ${LSP_MAP[$rid]:-};     do [[ "$keepm"  == *" $p "* ]] || PRUNE_MASON+=" $p"; done
}

# --------------------------------------------------------------------------
require_nvim_config() {
  [[ "$DISTRO" != none ]] && return 0
  die "não achei config de Neovim em $NVIM_CONFIG
     instale um distro:  deveditor           (LazyVim, AstroNvim, NvChad…)
     ou aponte outro:    devlang --appname <nome> $*"
}

# --------------------------------------------------------------------------
# instala UMA linguagem
# --------------------------------------------------------------------------
install_lang() {
  local id="$1"
  declare -F "lang_$id" >/dev/null || die "linguagem desconhecida: $id  (veja: devlang --list)"
  require_nvim_config "$id"

  LABEL=""; MISE_TOOLS=""; APT_PKGS=""; LAZY_EXTRA=""; MASON_PKGS=""; POST_FN=""
  "lang_$id"
  local ts="${TS_MAP[$id]:-$id}" lsp="${LSP_MAP[$id]:-}"

  printf '\n%s\n' "${c_bold}${c_blue}━━ $LABEL  →  ${APPNAME} (${DISTRO}) ━━${c_reset}"
  ensure_base "$MISE_TOOLS"
  install_apt  "$APT_PKGS"
  install_mise "$MISE_TOOLS"

  case "$DISTRO" in
    lazyvim)
      add_lazy_extra "$LAZY_EXTRA"
      provision_lazyvim "$MASON_PKGS" ""
      ;;
    astronvim)
      add_astro_pack "$id"
      provision_generic "$ts" "$lsp $MASON_PKGS"
      ;;
    nvchad|kickstart|unknown)
      provision_generic "$ts" "$lsp $MASON_PKGS"
      [[ "$DISTRO" == unknown ]] && warn "config não reconhecida — instalei parser+LSP; habilite o server na sua config"
      [[ "$DISTRO" == nvchad ]] && warn "NvChad: adicione \"$lsp\" aos servers em lua/configs/lspconfig.lua"
      ;;
  esac

  [[ -n "$POST_FN" ]] && declare -F "$POST_FN" >/dev/null && { say "Passo final ($POST_FN)…"; "$POST_FN"; }
  state_add "$id"
  printf '%s\n' "${c_green}${c_bold}✓ $LABEL pronto em ${APPNAME}.${c_reset}"
}

# --------------------------------------------------------------------------
# desinstala UMA linguagem
# --------------------------------------------------------------------------
uninstall_lang() {
  local id="$1"
  declare -F "lang_$id" >/dev/null || die "linguagem desconhecida: $id"
  require_nvim_config "$id"

  LABEL=""; MISE_TOOLS=""; APT_PKGS=""; LAZY_EXTRA=""; MASON_PKGS=""; POST_FN=""
  "lang_$id"

  printf '\n%s\n' "${c_bold}${c_blue}━━ remover: $LABEL  ←  ${APPNAME} (${DISTRO}) ━━${c_reset}"

  local PRUNE_TS="" PRUNE_MASON=""
  compute_prune_sets "$id"

  case "$DISTRO" in
    lazyvim)
      remove_lazy_extra "$LAZY_EXTRA"
      provision_lazyvim "" "" prune
      ;;
    astronvim)
      remove_astro_pack "$id"
      provision_generic "" "" "$PRUNE_TS" "$PRUNE_MASON"
      ;;
    nvchad|kickstart|unknown)
      provision_generic "" "" "$PRUNE_TS" "$PRUNE_MASON"
      ;;
  esac

  if [[ -n "${MISE_TOOLS// }" ]] && have mise; then
    for tool in $MISE_TOOLS; do
      local name="${tool%@*}"
      mise which "$name" >/dev/null 2>&1 || continue
      if confirm "Remover o runtime '$name' do mise também?"; then
        mise use -g --rm "$name" 2>/dev/null || true
        mise uninstall "$name" 2>/dev/null || true
        ok "mise: $name removido"
      else
        ok "mise: $name mantido"
      fi
    done
  fi
  [[ -n "${APT_PKGS// }" ]] && warn "pacotes apt de '$LABEL' mantidos: $APT_PKGS"

  state_del "$id"
  printf '%s\n' "${c_green}${c_bold}✓ $LABEL removido de ${APPNAME}.${c_reset}"
}

# --------------------------------------------------------------------------
# menu
# --------------------------------------------------------------------------
# emite "id<TAB>on|off<TAB>display"    filtro: all | installed | available
menu_rows() {
  local filter="${1:-all}" id lbl flag
  for id in "${LANG_IDS[@]}"; do
    LABEL=""; "lang_$id"; lbl="$LABEL"
    if is_installed "$id"; then flag=on; else flag=off; fi
    [[ "$filter" == installed && "$flag" == off ]] && continue
    [[ "$filter" == available && "$flag" == on  ]] && continue
    if [[ "$flag" == on ]]; then
      printf '%s\t%s\t● %s  (instalada)\n' "$id" "$flag" "$lbl"
    else
      printf '%s\t%s\t○ %s\n' "$id" "$flag" "$lbl"
    fi
  done
}

# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------
usage() { sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local action="" args=() want_list=0
  while (($#)); do
    case "$1" in
      -h|--help)               usage; exit 0 ;;
      -l|--list)               want_list=1 ;;
      -r|--remove|--uninstall) action="remove" ;;
      -i|--install)            action="install" ;;
      -y|--yes)                ASSUME_YES=1 ;;
      --gui)                   FORCE_ZENITY=1 ;;
      --appname)               shift; [[ -n "${1:-}" ]] || die "--appname requer um nome"; set_target "$1" ;;
      --appname=*)             set_target "${1#*=}" ;;
      --) shift; args+=("$@"); break ;;
      -*) die "opção desconhecida: $1" ;;
      *)  args+=("$1") ;;
    esac
    shift
  done

  if ((want_list)); then
    printf '%salvo:%s %s (%s)\n' "$c_bold" "$c_reset" "$APPNAME" "$DISTRO"
    menu_rows all | while IFS=$'\t' read -r id flag disp; do
      [[ "$flag" == on ]] && m="${c_green}✓${c_reset}" || m=" "
      printf '  %s %-12s %s\n' "$m" "$id" "${disp#* }"
    done
    exit 0
  fi

  # alvos passados na linha de comando
  if ((${#args[@]})); then
    for id in "${args[@]}"; do
      if [[ "$action" == remove ]]; then uninstall_lang "$id"; else install_lang "$id"; fi
    done
    printf '\n%s\n' "${c_green}${c_bold}Concluído.${c_reset}"
    return 0
  fi

  # Sem terminal algum (launch gráfico puro) ou --gui: pergunta a ação via zenity.
  # Com terminal, o menu unificado já cobre instalar E remover numa janela só.
  if [[ -z "$action" ]] && { [[ "${FORCE_ZENITY:-0}" == 1 ]] || [[ ! -t 2 && ! -e /dev/tty ]]; } && have zenity; then
    case "$(zenity --list --radiolist --width=320 --height=220 --title="devlang" \
              --text="O que deseja fazer?" --column="" --column="ação" \
              TRUE "Instalar linguagem" FALSE "Remover linguagem" 2>/dev/null)" in
      Remover*) action="remove" ;;
      Instalar*) action="install" ;;
      *) exit 0 ;;
    esac
  fi

  local selected=()
  case "$action" in
    remove)
      mapfile -t selected < <(menu_rows installed | choose "Linguagens para REMOVER de $APPNAME ($DISTRO)")
      ((${#selected[@]})) || { warn "nada selecionado"; exit 0; }
      for id in "${selected[@]}"; do id="${id//[[:space:]]/}"; [[ -n "$id" ]] && uninstall_lang "$id"; done
      ;;
    install)
      mapfile -t selected < <(menu_rows available | choose "Linguagens para INSTALAR em $APPNAME ($DISTRO)")
      ((${#selected[@]})) || { warn "nada selecionado"; exit 0; }
      for id in "${selected[@]}"; do id="${id//[[:space:]]/}"; [[ -n "$id" ]] && install_lang "$id"; done
      ;;
    *)
      # menu unificado: marcar uma instalada = remover; marcar uma disponível = instalar
      mapfile -t selected < <(menu_rows all | choose "$APPNAME ($DISTRO) · ● instalada (marcar remove) · ○ disponível (marcar instala)")
      ((${#selected[@]})) || { warn "nada selecionado"; exit 0; }
      for id in "${selected[@]}"; do
        id="${id//[[:space:]]/}"; [[ -z "$id" ]] && continue
        if is_installed "$id"; then uninstall_lang "$id"; else install_lang "$id"; fi
      done
      ;;
  esac

  printf '\n%s\n' "${c_green}${c_bold}Concluído.${c_reset}"
  desktop_close_prompt
}

main "$@"
